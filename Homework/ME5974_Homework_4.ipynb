    "import numpy as np\n",
    "N = 4\n",
    "def f_4(x): \n",
    "    f = 0\n",
    "    for i in range (N - 1):\n",
    "        f += 100  * (x[i+1] - x[i] ** 2) ** 2 + (1 - x[i]) ** 2\n",
    "    return f\n",
    "\n",
    "def constraint(x):\n",
    "    return sum(x)\n",
    "\n",
    "x_init = np.array([1.01,1.03,0.92,1.1])\n",
    "print(constraint(x_init))\n",
    "print(f_4(x_init))"
   ]
